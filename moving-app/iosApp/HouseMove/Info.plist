<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>HouseMove</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Ground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- iPhone stays portrait-only. App Store Connect still refuses an upload unless the iPad list (used when an
	     iPhone app runs on an iPad) has all four orientations, for iPad multitasking. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>HouseMove uses the camera to scan box labels and barcodes and to take photos of your things.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>HouseMove finds the other phones of your move on your Wi-Fi and shares the move with them.</string>
	<!-- HouseMove's own Bonjour type (design/auto-sync.md). While the app is open, the phones of a move find each other
	     with it and sync by themselves: each advertises HM-<tag>-<random>, where the tag changes every hour and only
	     phones of the move can work it out (no names, no move). The app also advertises it briefly to ask iOS whether
	     the local network is allowed (IosHooks.kt, LocalNetworkCheck). -->
	<key>NSBonjourServices</key>
	<array>
		<string>_housemove._tcp</string>
	</array>
	<!-- An Android phone's invite and sync code are QR codes holding HMSYNC:…, a link of this kind: the iPhone's
	     Camera offers to open it in HouseMove (HouseMoveApp.swift, onOpenURL). So is the internet mailbox's setup code,
	     HMBOX:… (from 2.5, design/encryption.md, "Mailbox as built"). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.housemove.ios.code</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hmsync</string>
				<string>hmbox</string>
			</array>
		</dict>
	</array>
	<!-- Files HouseMove opens from other apps ("Open in HouseMove" from Files, Mail, Messages or AirDrop; step 3b of
	     design/ios-plan.md): its update files (Send update: Android's .housemove, application/vnd.housemove.update),
	     whose type it declares below, and backups, which are zip files (Android's housemove-backup-….zip): HouseMove is
	     offered for a zip but is never the app a zip opens in by default. The file is copied into the app rather than
	     opened in place, and reaches the shared screens as a file link (HouseMoveApp.swift, onOpenURL; IosFiles.kt). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>HouseMove update</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.housemove.update</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>HouseMove backup</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.zip-archive</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.housemove.update</string>
			<key>UTTypeDescription</key>
			<string>HouseMove update</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>housemove</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.housemove.update</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>

<resources>
    <!--
        The app is always dark ("Night house"). The window itself starts on the night
        ground, so there is no white flash before the first frame is drawn.
    -->
    <style name="Theme.HouseMove" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
    What Android's own backup and phone-to-phone transfer copy (Android 12 and later): the same
    small per-move data as backup_rules.xml, and no photos, phone ID or label numbers.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="moves.json" />
        <include domain="file" path="phone.json" />
        <include domain="file" path="moves/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="moves.json" />
        <include domain="file" path="phone.json" />
        <include domain="file" path="moves/" />
    </device-transfer>
</data-extraction-rules>
